[Unit]
Description=Run the bounded SFO Strategy Lab public refresh every ten minutes

[Timer]
# Decorrelate firing so the sfo units don't all spike together
RandomizedDelaySec=30
OnActiveSec=4min
OnUnitInactiveSec=10min
AccuracySec=30s
Persistent=true
Unit=sfo-strategy-lab-refresh.service

[Install]
WantedBy=timers.target
