[Unit]
Description=Run the bounded SFO Strategy Lab public refresh every five minutes

[Timer]
# Use a wall-clock schedule so slow or failed builds do not permanently shift
# later runs. systemd coalesces an elapsed firing while the oneshot is active.
RandomizedDelaySec=30
OnCalendar=*-*-* *:00,05,10,15,20,25,30,35,40,45,50,55
AccuracySec=30s
Persistent=true
Unit=sfo-strategy-lab-refresh.service

[Install]
WantedBy=timers.target
