[Unit]
Description=Refresh temporary Apple Weather data at four fixed UTC vintages

[Timer]
# Retired timer, excluded from the thirteen active timers. Manual operation
# for twenty cities would make four requests per city/day = eighty calls/day.
# Keep vintages fixed in UTC so DST cannot move the research cutoffs.
RandomizedDelaySec=60
AccuracySec=1s
OnCalendar=*-*-* 02,08,14,20:17:00 UTC
Persistent=true
Unit=weatheredge-apple-refresh.service

[Install]
WantedBy=timers.target
