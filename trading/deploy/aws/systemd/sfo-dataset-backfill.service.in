[Unit]
Description=WeatherEdge nightly dataset + multi-city archive maintenance
Wants=network-online.target
After=network-online.target
OnFailure=sfo-alert@%n.service

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__TRADING_DIR__
EnvironmentFile=__ENV_FILE__
# systemd stops a oneshot unit at its first failing command without a `-`
# prefix. The dataset step carries one so a failed dataset night (a source
# failing on consecutive runs, or dataset research failing) cannot skip the
# maintenance below; if that maintenance succeeds, ExecStartPost fails the
# unit with the dataset step's own result, so OnFailure still alerts.
ExecStart=-/usr/bin/env bash __TRADING_DIR__/deploy/aws/run_dataset_backfill.sh
# Multi-city training-data maintenance (nightly is enough; the newest scored
# day lands within one day, immaterial against a ~340-day archive):
# yesterday's CLI settlements from the IEM archive (also picks up corrected
# finals), the leakage-free NWP previous-runs rows, and the rolling-origin
# EMOS rebuild that refreshes every city's calibration record.
# The wrapper runs all four steps before returning failure; do not ignore its
# result, or a healthy dataset step would conceal a failed forecaster step.
ExecStart=/usr/bin/env bash __TRADING_DIR__/deploy/aws/run_forecaster_maintenance.sh __FORECASTER_DIR__
# Re-raise the dataset step's result, which it records under this run's
# INVOCATION_ID. It is ExecStartPost, not a last ExecStart, so it does not
# replace the main-process record (ExecMain*) the runbook's timing check reads.
ExecStartPost=/usr/bin/env bash __TRADING_DIR__/deploy/aws/run_dataset_backfill.sh --report-status
Nice=10
# Contain a runaway process to this unit instead of letting the kernel
# OOM-killer pick an arbitrary victim (t4g.small, 2 GiB RAM: containment, not
# thrash-protection).
MemoryHigh=600M
MemoryMax=800M
# Five sequential network-bound backfill steps legitimately run long;
# an explicit start timeout (oneshot defaults to no timeout) bounds a hung run.
# 2700 s (was 1800) since the registry grew to twenty
# cities (2026-09-13): the all-city rolling-origin EMOS rebuild at leads 1 and 2
# fits a third more stations and has no runtime measurement yet. The `-` prefix
# ignores exit codes but not this timeout, which would SIGTERM the chain mid
# rebuild. Nothing downstream waits on this unit, so the longer ceiling moves no
# schedule. Time the first twenty-city run (operational runbook) and revisit.
TimeoutStartSec=2700
