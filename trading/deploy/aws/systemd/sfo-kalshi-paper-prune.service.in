[Unit]
Description=SFO paper decision-journal retention prune
Wants=network-online.target
After=network-online.target
OnFailure=sfo-alert@%n.service

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__TRADING_DIR__
EnvironmentFile=__ENV_FILE__
# Keep the highest-volume table bounded: full fidelity for the last day,
# per-day dedup back to 45 days, approved rows never deleted. The lossless
# archive export gate runs first; a failed archive aborts before the prune.
ExecStart=/usr/bin/env bash __TRADING_DIR__/deploy/aws/run_archive_then_prune.sh
Nice=10
# Contain a runaway process to this unit instead of letting the kernel
# OOM-killer pick an arbitrary victim (4 GB box: containment, not
# thrash-protection).
#
# MemoryHigh sizing (2026-08-09): cgroup memory accounting INCLUDES the page
# cache of every DB page this job reads. Walking the retention windows of a
# 14+ GB journal needs well over the old 1200M ceiling, and once the cgroup
# crosses MemoryHigh the kernel reclaims the job's own cache continuously --
# observed as 3m49s of CPU across 21 minutes of wall clock ("available: 488K",
# swapping) followed by the TimeoutStartSec kill two nights running. Page
# cache is reclaimable, so a higher MemoryHigh does not starve the box; the
# anonymous-memory disaster case is still fenced by MemoryMax.
MemoryHigh=2600M
MemoryMax=3000M
# The archive-then-prune chain legitimately runs long on backlog days; raise
# the start timeout above the 90 s oneshot default so it is not killed mid-run.
# 3600 covers a cold-cache catch-up night on the current journal; the batched
# prune commits per batch, so even a kill leaves durable progress.
TimeoutStartSec=3600
