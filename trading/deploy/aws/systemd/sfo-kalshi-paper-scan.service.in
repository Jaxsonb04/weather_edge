[Unit]
Description=WeatherEdge multi-city paper-account scan
Wants=network-online.target
After=network-online.target
OnFailure=sfo-alert@%n.service

[Service]
Type=oneshot
# Five-minute ticks; allow three ticks for both profiles and lock retries,
# while bounding a hang inside the watchdog's 20-minute scan-age window.
TimeoutStartSec=900
User=__APP_USER__
WorkingDirectory=__TRADING_DIR__
EnvironmentFile=__ENV_FILE__
# The retired aggregate switch must not leak into the scheduled scanner. Each
# live/target/M1 paper account is controlled by its own default-off flag.
# Motion is archived; its placement flag is ignored.
UnsetEnvironment=SFO_PAPER_PLACE_ORDERS
ExecStart=/usr/bin/env bash __TRADING_DIR__/deploy/aws/run_paper_scan_profiles.sh
Nice=0
# Contain a runaway process to this unit instead of letting the kernel
# OOM-killer pick an arbitrary victim (t4g.small, 2 GiB RAM: containment, not
# thrash-protection).
MemoryHigh=400M
MemoryMax=512M
