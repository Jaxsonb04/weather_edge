[Unit]
Description=SFO Strategy Lab trading-results refresh
Wants=network-online.target
After=network-online.target
OnFailure=sfo-alert@%n.service

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__FORECASTER_DIR__
EnvironmentFile=__ENV_FILE__
# run_publication_cycle.sh forces the bounded flag after EnvironmentFile
# loading, so an operator override cannot accidentally restore full scanning.
ExecStart=/bin/bash __TRADING_DIR__/deploy/aws/run_publication_cycle.sh strategy
Nice=10
CPUWeight=50
# Contain a runaway strategy-research build to this unit instead of letting
# the kernel OOM-killer pick an arbitrary victim (4 GB box: containment).
MemoryHigh=1200M
MemoryMax=1600M
# The recurring public path explicitly defers the unbounded decision-journal
# replay. Keep the freshness budget honest and fail a regressed build quickly.
TimeoutStartSec=120
