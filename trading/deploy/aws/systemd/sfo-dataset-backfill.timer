[Unit]
Description=Run SFO compact dataset backfill nightly

[Timer]
# Start after the prune unit's worst-case 09:55 UTC finish and finish before
# the next hourly forecaster refresh, even with both units' full timeouts.
RandomizedDelaySec=120
OnCalendar=*-*-* 10:00:00 UTC
Persistent=true
Unit=sfo-dataset-backfill.service

[Install]
WantedBy=timers.target
